{
  "manifest_version": 3,
  "name": "FlyBy for Gmail",
  "version": "0.5.3",
  "description": "Remind me button in Gmail's compose window: bring the thread back if nobody replies.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pageWorld.js"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "options_page": "options.html"
}
